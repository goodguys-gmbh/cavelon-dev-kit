  "features": {
    "sandbox_feature_enabled": false,
    "sandbox_outbound_enrollment_enabled": false,
    "sandbox_isolated_container_enabled": false,
    "masterloop_enabled": false,
    "database_connector_enabled": false,
    "personal_access_tokens_enabled": false,
    "operations_api_enabled": false
  },
  "database_connector": {
    "setting": "DATABASE_CONNECTOR_ENABLED",
    "dialects": [],
    "may_write_queries": false,
    "queries_written_by": "A superadmin in Tenant mode, signed in to the Admin: under Settings → Databases, or by importing a package from the solution's Agents page (Import JSON). A personal access token or an API key never creates or changes a database query; its import passes while the package's queries match the tenant's."
  },
  "sandbox": {
    "execution_modes": []
  },
  "masterloop": {
    "max_active_per_tenant": 10,
    "max_deadline_seconds": 604800,
    "default_limits": {
      "max_iterations": 12,
      "deadline_seconds": 14400,
      "max_iteration_seconds": 900,
      "max_model_requests": 400,
      "max_input_tokens": 15000000,
      "max_output_tokens": 400000,
      "max_command_seconds": 300,
      "max_no_progress_iterations": 3,
      "max_iteration_turns": 100
    }
  },
  "experimental_tools": [
    {
      "key": "spawn_subagents",
      "enabled": true,
      "setting": "AGENT_DYNAMIC_SUBAGENTS_ENABLED"
    }
  ],
