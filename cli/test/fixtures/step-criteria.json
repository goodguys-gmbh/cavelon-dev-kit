{
  "$defs": {
    "CriterionSpec": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "dimension": {
          "default": "content",
          "enum": [
            "content",
            "style"
          ],
          "title": "Dimension",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "CriterionSpec",
      "type": "object"
    },
    "DateRangeCriterion": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "type": {
          "const": "date_range_within",
          "title": "Type",
          "type": "string"
        },
        "start": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "type",
        "start",
        "end"
      ],
      "title": "DateRangeCriterion",
      "type": "object"
    },
    "LanguageCriterion": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "type": {
          "const": "language_is",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "pattern": "^[A-Za-z]{2,3}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "LanguageCriterion",
      "type": "object"
    },
    "MinResultsCriterion": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "type": {
          "const": "min_results",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Value",
          "type": "integer"
        },
        "tool": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "MinResultsCriterion",
      "type": "object"
    },
    "RoutingCriterion": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "type": {
          "enum": [
            "answered_by",
            "handoff_to"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "RoutingCriterion",
      "type": "object"
    },
    "TextMatchCriterion": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "type": {
          "enum": [
            "must_contain",
            "must_not_contain"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "match": {
          "default": "literal",
          "enum": [
            "literal",
            "regex"
          ],
          "title": "Match",
          "type": "string"
        },
        "case_sensitive": {
          "default": false,
          "title": "Case Sensitive",
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "TextMatchCriterion",
      "type": "object"
    },
    "ToolCriterion": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "type": {
          "enum": [
            "tool_called",
            "tool_not_called"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "ToolCriterion",
      "type": "object"
    },
    "URLCriterion": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "type": {
          "const": "url_matches",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "match": {
          "default": "starts_with",
          "enum": [
            "equals",
            "starts_with"
          ],
          "title": "Match",
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "URLCriterion",
      "type": "object"
    }
  },
  "items": {
    "anyOf": [
      {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      {
        "$ref": "#/$defs/CriterionSpec"
      },
      {
        "discriminator": {
          "mapping": {
            "answered_by": "#/$defs/RoutingCriterion",
            "date_range_within": "#/$defs/DateRangeCriterion",
            "handoff_to": "#/$defs/RoutingCriterion",
            "language_is": "#/$defs/LanguageCriterion",
            "min_results": "#/$defs/MinResultsCriterion",
            "must_contain": "#/$defs/TextMatchCriterion",
            "must_not_contain": "#/$defs/TextMatchCriterion",
            "tool_called": "#/$defs/ToolCriterion",
            "tool_not_called": "#/$defs/ToolCriterion",
            "url_matches": "#/$defs/URLCriterion"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MinResultsCriterion"
          },
          {
            "$ref": "#/$defs/TextMatchCriterion"
          },
          {
            "$ref": "#/$defs/LanguageCriterion"
          },
          {
            "$ref": "#/$defs/URLCriterion"
          },
          {
            "$ref": "#/$defs/ToolCriterion"
          },
          {
            "$ref": "#/$defs/RoutingCriterion"
          },
          {
            "$ref": "#/$defs/DateRangeCriterion"
          }
        ]
      }
    ]
  },
  "type": "array"
}
